      "type": "qcm",
      "q": {
        "fr": "Quel déterminant devant « arbre » ?",
        "ar": "أي محدد قبل «شجرة»؟"
      },
      "choix": [
        {
          "fr": "un",
          "ar": "un"
        },
        {
          "fr": "une",
          "ar": "une"
        },
        {
          "fr": "des la",
          "ar": "des la"
        }
      ],
      "bonne": 0,
      "explication": {
        "fr": "Arbre = masculin singulier → un.",
        "ar": "شجرة = مذكر مفرد ← un."
      }
    },
    {
      "id": "q3",
      "type": "vf",
      "q": {
        "fr": "Dans « Nouakchott », on met une majuscule car c'est un nom propre.",
        "ar": "في «نواكشوط» نكتب الحرف كبيراً لأنه اسم جاهر."
      },
      "bonne": true,
      "explication": {
        "fr": "Nom de ville.",
        "ar": "اسم مدينة."
      }
    },
    {
      "id": "q4",
      "type": "qcm",
      "q": {
        "fr": "« ___ amie est fidèle. » (possessif, à toi)",
        "ar": "«___ صديقة وفيّة.» (ملكية لك)"
      },
      "choix": [
        {
          "fr": "Ta",
          "ar": "صديقتك"
        },
        {
          "fr": "Ton",
          "ar": "صديقك"
        },
        {
          "fr": "Tes",
          "ar": "أصدقاؤك"
        }
      ],
      "bonne": 0,
      "explication": {
        "fr": "Amie = féminin singulier → ta.",
        "ar": "صديقة = مؤنث مفرد ← ta."
      }
    },
    {
      "id": "q5",
      "type": "courte",
      "q": {
        "fr": "Écris l'accord : « une veste (gris) ».",
        "ar": "اكتب المطابقة: «سترة (رمادي)»."
      },
      "acceptees": [
        "grise"
      ],
      "explication": {
        "fr": "Féminin singulier → grise.",
        "ar": "مؤنث مفرد ← grise."
      }
    },
    {
      "id": "q6",
      "type": "qcm",
      "q": {
        "fr": "« des bateaux » : pourquoi -x ?",
        "ar": "«قوارب»: لماذا -x؟"
      },
      "choix": [
        {
          "fr": "Les noms en -eau prennent -x",
          "ar": "الأسماء المنتهية بـ -eau تأخذ -x"
        },
        {
          "fr": "C'est irrégulier",
          "ar": "جمع شاذ"
        },
        {
          "fr": "Pour faire joli",
          "ar": "للجمال فقط"
        }
      ],
      "bonne": 0,
      "explication": {
        "fr": "Règle des noms en -eau.",
        "ar": "قاعدة الأسماء المنتهية بـ -eau."
      }
    },
    {
      "id": "q7",
      "type": "qcm",
      "q": {
        "fr": "Quel déterminant démonstratif ?",
        "ar": "أي محدد إشارة؟"
      },
      "choix": [
        {
          "fr": "ce",
          "ar": "هذا"
        },
        {
          "fr": "mon",
          "ar": "ملكي"
        },
        {
          "fr": "les",
          "ar": "الـ"
        }
      ],
      "bonne": 0,
      "explication": {
        "fr": "ce, cet, cette, ces.",
        "ar": "ce، cet، cette، ces."
      }
    },
    {
      "id": "q8",
      "type": "courte",
      "q": {
        "fr": "Déterminant de « ___ fleurs » (féminin pluriel) ?",
        "ar": "محدد «___ أزهار» (مؤنث جمع)؟"
      },
      "acceptees": [
        "les",
        "des",
        "ces",
        "mes"
      ],
      "explication": {
        "fr": "les/des/ces/mes fleurs.",
        "ar": "les أو des…"
      }
    }
  ],
