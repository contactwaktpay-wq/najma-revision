{
  "schema": "sehil.unit@1",
  "statut": "PUBLIE",
  "id": "6AF-fr-02",
  "niveau": "6AF",
  "matiere": "francais",
  "ordre": 2,
  "titre": {
    "fr": "Noms, déterminants et adjectifs",
    "ar": "الأسماء والمحددات والصفات"
  },
  "duree_min": 25,
  "objectifs": {
    "fr": [
      "Distinguer noms communs et noms propres, singulier et pluriel",
      "Employer les déterminants (articles, possessifs, démonstratifs)",
      "Accorder l'adjectif qualificatif avec le nom"
    ],
    "ar": [
      "التمييز بين الأسماء الجاهرة والعامة والمفرد والجمع",
      "استعمال المحددات (الأدوات، الملكية، الإشارة)",
      "مطابقة الصفة مع الاسم"
    ]
  },
  "fiche": [
    {
      "titre": {
        "fr": "Le nom et son nombre",
        "ar": "الاسم وعدده"
      },
      "puces": [
        {
          "fr": "Nom commun : désigne une catégorie (un chameau, la mer). Nom propre : désigne une personne ou un lieu précis (Moussa, Nouakchott) → majuscule.",
          "ar": "الاسم العام: يدل على صنف (جمل، البحر). الاسم الجاهر: يدل على شخص أو مكان معين (موسى، نواكشوط) ← بحرف كبير."
        },
        {
          "fr": "Pluriel régulier : + s (les dattes). Pluriels en -eau/-eu : + x (un bateau → des bateaux ; un jeu → des jeux).",
          "ar": "الجمع المنتظم: + s. الجمع المنتهي بـ -eau/-eu: + x (قارب ← قوارب)."
        },
        {
          "fr": "Pluriels irréguliers à connaître : un cheval → des chevaux ; un œil → des yeux.",
          "ar": "جمع شاذ يجب حفظه: حصان ← خيول ؛ عين ← عيون."
        }
      ]
    },
    {
      "titre": {
        "fr": "Les déterminants",
        "ar": "المحددات"
      },
      "puces": [
        {
          "fr": "Articles définis : le, la, l', les. Articles indéfinis : un, une, des.",
          "ar": "الأدوات المعرفة: le، la، l'، les. الأدوات النكرة: un، une، des."
        },
        {
          "fr": "Possessifs : mon, ton, son, notre, votre, leur (+ féminin ma, ta, sa ; pluriel mes, tes, ses…).",
          "ar": "أدوات الملكية: mon، ton، son، notre، votre، leur (والمؤنث ma، ta، sa؛ والجمع mes، tes، ses…)."
        },
        {
          "fr": "Démonstratifs : ce, cet (devant voyelle), cette, ces.",
          "ar": "أدوات الإشارة: ce، cet (قبل حرف علة)، cette، ces."
        }
      ]
    },
    {
      "titre": {
        "fr": "L'adjectif qualificatif",
        "ar": "الصفة النوعية"
      },
      "bloc": [
        {
          "fr": "L'adjectif qualifie le nom : il s'accorde en genre et en nombre avec lui. « Un marché coloré », « une rue animée », « des dunes dorées ».",
          "ar": "الصفة تصف الاسم: تطابقه في الجنس والعدد. «سوق ملوّن»، «شارع مزدحم»، «كثبان ذهبية»."
        }
      ],
      "exemple": {
        "enonce": {
          "fr": "Accorde : « des sandales (neuf) » ; « une étoile (brillant) ».",
          "ar": "طبّق المطابقة: «أحذية (جديد)» ؛ «نجمة (لامعة)»."
        },
        "etapes": [
          {
            "fr": "Sandales = féminin pluriel → neuv-es → « des sandales neuves ».",
            "ar": "أحذية = مؤنث جمع ← «جديدة»."
          },
          {
            "fr": "Étoile = féminin singulier → brillant-e → « une étoile brillante ».",
            "ar": "نجمة = مؤنث مفرد ← «لامعة»."
          }
        ],
        "resultat": {
          "fr": "neuves ; brillante",
          "ar": "جديدة؛ لامعة"
        }
      }
    }
  ],
  "definitions": [
    {
      "terme": {
        "fr": "Nom commun",
        "ar": "اسم عام"
      },
      "def": {
        "fr": "Désigne une classe d'êtres ou d'objets.",
        "ar": "يدل على صنف من المخلوقات أو الأشياء."
      }
    },
    {
      "terme": {
        "fr": "Nom propre",
        "ar": "اسم جاهر"
      },
      "def": {
        "fr": "Désigne une personne ou un lieu unique, avec majuscule.",
        "ar": "يدل على شخص أو مكان واحد، بحرف كبير."
      }
    },
    {
      "terme": {
        "fr": "Déterminant",
        "ar": "المحدِّد"
      },
      "def": {
        "fr": "Mot placé devant le nom pour l'introduire (article, possessif, démonstratif…).",
        "ar": "كلمة قبل الاسم لإدخاله (أداة، ملكية، إشارة…)."
      }
    },
    {
      "terme": {
        "fr": "Adjectif qualificatif",
        "ar": "صفة نوعية"
      },
      "def": {
        "fr": "Mot qui donne une qualité du nom et s'accorde avec lui.",
        "ar": "كلمة تبيّن صفة من صفات الاسم وتطابقه."
      }
    }
  ],
  "exercices": [
    {
      "id": "e1",
      "niveau_diff": 1,
      "enonce": {
        "fr": "Mets au pluriel : « un cheval » ; « un jeu ».",
        "ar": "حوّل إلى الجمع: «حصان» ؛ «لعبة»."
      },
      "correction": {
        "etapes": [
          {
            "fr": "Pluriel irrégulier en -aux ; pluriel régulier des noms en -eu → -eux.",
            "ar": "جمع شاذ بـ -aux؛ وجمع منتظم للمنتهي بـ -eu ← -eux."
          }
        ],
        "resultat": {
          "fr": "des chevaux ; des jeux",
          "ar": "خيول ؛ ألعاب"
        }
      }
    },
    {
      "id": "e2",
      "niveau_diff": 2,
      "enonce": {
        "fr": "Complète avec un démonstratif : « ___ fleurs sont magnifiques. »",
        "ar": "أكمل بأداة إشارة: «___ أزهار رائعة.»"
      },
      "correction": {
        "etapes": [
          {
            "fr": "Fleurs = féminin pluriel → ces.",
            "ar": "أزهار = مؤنث جمع ← ces."
          }
        ],
        "resultat": {
          "fr": "Ces",
          "ar": "هذه"
        }
      }
    },
    {
      "id": "e3",
      "niveau_diff": 3,
      "enonce": {
        "fr": "Accorde les adjectifs : « des maisons (blanc) et (haut) ».",
        "ar": "طبّق المطابقة: «بيوت (أبيض) و(عالي)»."
      },
      "correction": {
        "etapes": [
          {
            "fr": "Maisons = féminin pluriel → blanches, hautes.",
            "ar": "بيوت = مؤنث جمع ← بيضاء وعالية."
          }
        ],
        "resultat": {
          "fr": "des maisons blanches et hautes",
          "ar": "بيوت بيضاء وعالية"
        }
      }
    },
    {
      "id": "e4",
      "niveau_diff": 2,
      "enonce": {
        "fr": "Remplace le déterminant par un possessif : « le cartable de l’élève » → « ___ cartable » ; « la maison de Fatou » → « ___ maison ».",
        "ar": "استبدل المحل بضمير ملكية: «حقيبة التلميذ» ← «___ حقيبة»؛ «بيت فاتو» ← «___ بيت»."
      },
      "correction": {
        "etapes": [
          {
            "fr": "son cartable ; sa maison.",
            "ar": "حقيبته؛ بيته."
          }
        ],
        "resultat": {
          "fr": "son ; sa",
          "ar": "son؛ sa"
        }
      }
    },
    {
      "id": "e5",
      "niveau_diff": 3,
      "enonce": {
        "fr": "Dans « Ces pêcheurs du Banc d’Arguin vendent leurs poissons au marché central. », trouve les déterminants et les noms.",
        "ar": "في الجملة أوجد المحددات والأسماء."
      },
      "correction": {
        "etapes": [
          {
            "fr": "Déterminants : ces, leurs, au (à + le) ; noms : pêcheurs, poissons, marché.",
            "ar": "المحددات: ces، leurs؛ الأسماء: pêcheurs، poissons، marché."
          }
        ],
        "resultat": {
          "fr": "Voir étapes",
          "ar": "انظر الخطوات"
        }
      }
    }
  ],
  "quiz": [
    {
