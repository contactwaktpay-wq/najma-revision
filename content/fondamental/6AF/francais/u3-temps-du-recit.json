    },
    {
      "id": "q6",
      "type": "courte",
      "q": {
        "fr": "Futur de « être » : nous…",
        "ar": "مستقبل «être»: nous…"
      },
      "acceptees": [
        "serons"
      ],
      "explication": {
        "fr": "Radical « ser- ».",
        "ar": "الجذع «ser-»."
      }
    },
    {
      "id": "q7",
      "type": "qcm",
      "q": {
        "fr": "« Quand il était petit, il ___ souvent au fleuve. »",
        "ar": "«في صغره كان كثيراً ___ إلى النهر»."
      },
      "choix": [
        {
          "fr": "allait",
          "ar": "يذهب"
        },
        {
          "fr": "est allé",
          "ar": "ذهب"
        },
        {
          "fr": "ira",
