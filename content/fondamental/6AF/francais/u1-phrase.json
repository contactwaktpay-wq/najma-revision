        }
      ],
      "bonne": 0,
      "explication": {
        "fr": "Sujet pluriel → -ent.",
        "ar": "الفاعل جمع ← صيغة الجمع."
      }
    },
    {
      "id": "q4",
      "type": "vf",
      "q": {
        "fr": "Une phrase déclarative se termine toujours par un point.",
        "ar": "الجملة الخبرية تنتهي دائماً بنقطة."
      },
      "bonne": true,
      "explication": {
