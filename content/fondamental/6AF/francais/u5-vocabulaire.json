{
  "schema": "sehil.unit@1",
  "statut": "PUBLIE",
  "id": "6AF-fr-05",
  "niveau": "6AF",
  "matiere": "francais",
  "ordre": 5,
  "titre": {
    "fr": "Vocabulaire : sens des mots et familles de mots",
    "ar": "المفردات: معاني الكلمات وعائلات الكلمات"
  },
  "duree_min": 25,
  "objectifs": {
    "fr": [
      "Utiliser synonymes et antonymes",
      "Construire des familles de mots avec préfixes et suffixes",
      "Distinguer sens propre et sens figuré",
      "Se servir d'un dictionnaire"
    ],
    "ar": [
      "استعمال المرادفات والأضداد",
      "بناء عائلات الكلمات بالسوابق واللواحق",
      "التمييز بين المعنى الحقيقي والمجازي",
      "استعمال القاموس"
    ]
  },
  "fiche": [
    {
      "titre": {
        "fr": "Synonymes et antonymes",
        "ar": "المرادفات والأضداد"
      },
      "puces": [
        {
          "fr": "Synonyme : mot de sens proche (joindre ≈ réunir). Choisis le synonyme adapté au contexte.",
          "ar": "المرادف: كلمة قريبة المعنى. اختر المرادف المناسب للسياق."
        },
        {
          "fr": "Antonyme : mot de sens contraire (montée ↔ descente ; chaud ↔ froid).",
          "ar": "الضد: كلمة معاكسة المعنى."
        }
      ]
    },
    {
      "titre": {
        "fr": "Préfixes et suffixes",
        "ar": "السوابق واللواحق"
      },
      "puces": [
        {
          "fr": "Préfixe « re- » = encore une fois : refaire, relire. Préfixe « in-/im- » = contraire : impossible, injuste.",
          "ar": "السابقة «re-» = مرة أخرى. السابقة «in-/im-» = العكس."
        },
        {
          "fr": "Suffixes courants : -tion (action), -able (portable), -eux (heureux, courageux).",
          "ar": "لواحق شائعة: -tion، -able، -eux."
        }
      ],
      "exemple": {
        "enonce": {
          "fr": "Familles de « mer » : maritime, marin, émar… Trouve deux mots de la même famille.",
          "ar": "عائلة «mer»: maritime، marin… اذكر كلمتين من العائلة نفسها."
        },
        "etapes": [
          {
            "fr": "Mots construits sur le même radical : marin, maritime.",
            "ar": "كلمات مبنية على الجذع نفسه: marin، maritime."
          }
        ],
        "resultat": {
          "fr": "marin, maritime (aussi : marée, amarrer)",
          "ar": "marin، maritime (أيضاً: marée، amarrer)"
        }
      }
    },
    {
      "titre": {
        "fr": "Sens propre et sens figuré",
        "ar": "المعنى الحقيقي والمجازي"
      },
      "puces": [
        {
          "fr": "Sens propre : sens direct (une étoile dans le ciel).",
          "ar": "المعنى الحقيقي: المعنى المباشر (نجمة في السماء)."
        },
        {
          "fr": "Sens figuré : image (cette élève est une étoile = elle brille par ses résultats).",
          "ar": "المعنى المجازي: صورة (هذا التلميذ نجمة = يتفوق)."
        }
      ],
      "tableau": {
        "entetes": [
          {
            "fr": "Expression",
            "ar": "العبارة"
          },
          {
            "fr": "Sens figuré",
            "ar": "المعنى المجازي"
          }
        ],
        "lignes": [
          [
            "« avoir le cœur d'or »",
            {
              "fr": "être très bon",
              "ar": "أن يكون طيباً جداً"
            }
          ],
          [
            "« un océan de patience »",
            {
              "fr": "beaucoup de patience",
              "ar": "كثير من الصبر"
            }
          ],
          [
            "« brûler les étapes »",
            {
              "fr": "aller trop vite",
              "ar": "أن يسير بسرعة زائدة"
            }
          ]
        ]
      }
    }
  ],
  "definitions": [
    {
      "terme": {
        "fr": "Synonyme",
        "ar": "مرادف"
      },
      "def": {
        "fr": "Mot de sens voisin.",
        "ar": "كلمة قريبة المعنى."
      }
    },
    {
      "terme": {
        "fr": "Antonyme",
        "ar": "ضد"
      },
      "def": {
        "fr": "Mot de sens contraire.",
        "ar": "كلمة معاكسة المعنى."
      }
    },
    {
      "terme": {
        "fr": "Famille de mots",
        "ar": "عائلة الكلمات"
      },
      "def": {
        "fr": "Mots formés sur le même radical.",
        "ar": "كلمات مبنية على الجذع نفسه."
      }
    },
    {
      "terme": {
        "fr": "Dictionnaire",
        "ar": "القاموس"
      },
      "def": {
        "fr": "Ouvrage qui donne le sens, la nature et l'orthographe des mots, par ordre alphabétique.",
        "ar": "كتاب يعطي المعنى والنوع والكتابة الصحيحة للكلمات بترتيب ألفبائي."
      }
    }
  ],
  "exercices": [
    {
      "id": "e1",
      "niveau_diff": 1,
      "enonce": {
        "fr": "Donne un antonyme de « monter ».",
        "ar": "اذكر ضد «الصعود»."
      },
      "correction": {
        "etapes": [
          {
            "fr": "Sens contraire de monter.",
            "ar": "المعنى المعاكس للصعود."
          }
        ],
        "resultat": {
          "fr": "descendre",
          "ar": "الهبوط"
        }
      },
      "acceptees": [
        "descendre"
      ]
    },
    {
      "id": "e2",
      "niveau_diff": 2,
      "enonce": {
        "fr": "Construis le mot contraire avec un préfixe : « possible », « juste », « heureux ».",
        "ar": "ابنِ الكلمة المعاكسة بسابقة: possible، juste، heureux."
      },
      "correction": {
        "etapes": [
          {
            "fr": "Préfixe in-/im- selon le son : impossible, injuste, malheureux (cas particulier).",
            "ar": "سابقة in-/im- حسب الصوت: impossible، injuste، malheureux (حالة خاصة)."
          }
        ],
        "resultat": {
          "fr": "impossible ; injuste ; malheureux",
          "ar": "impossible ؛ injuste ؛ malheureux"
        }
      }
    },
    {
      "id": "e3",
      "niveau_diff": 3,
      "enonce": {
        "fr": "Sens propre ou figuré : « un torrent de paroles » ; « nager dans la rivière » ?",
        "ar": "حقيقي أم مجازي: «سيل من الكلام» ؛ «السباحة في النهر»؟"
      },
      "correction": {
        "etapes": [
          {
            "fr": "« Torrent de paroles » = beaucoup de mots (figuré) ; « nager » = action réelle (propre).",
            "ar": "«سيل من الكلام» = مجازي؛ «السباحة» = حقيقية."
          }
        ],
        "resultat": {
          "fr": "figuré ; propre",
          "ar": "مجازي ؛ حقيقي"
        }
      }
    },
    {
      "id": "e4",
      "niveau_diff": 2,
      "enonce": {
        "fr": "Donne 2 synonymes de « rapide » et 2 de « travail ».",
        "ar": "أعط مترادفين لـ «rapide» واثنين لـ «travail»."
      },
      "correction": {
        "etapes": [
          {
            "fr": "rapide : vite, pressé ; travail : ouvrage, tâche.",
            "ar": "rapide: vite؛ travail: ouvrage."
          }
        ],
        "resultat": {
          "fr": "vite/pressé ; ouvrage/tâche",
          "ar": "انظر الخطوات"
        }
      }
    },
    {
      "id": "e5",
      "niveau_diff": 3,
      "enonce": {
        "fr": "Construis le champ lexical de « la mer » (4 mots minimum).",
        "ar": "ابنِ الحقل الدلالي لـ «البحر» (4 كلمات على الأقل)."
      },
      "correction": {
        "etapes": [
          {
            "fr": "Ex. : pêcheur, bateau, vague, poisson, port, salé.",
            "ar": "مثال: صياد، قارب، موجة، سمك، ميناء، مالح."
          }
        ],
        "resultat": {
          "fr": "4+ mots liés à la mer",
          "ar": "أربع كلمات فأكثر"
        }
      }
    }
  ],
