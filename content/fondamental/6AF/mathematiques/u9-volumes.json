    {
      "id": "q4",
      "type": "calcul",
      "q": {
        "fr": "Convertis 5 m³ en litres.",
        "ar": "حوّل 5 م³ إلى لترات."
      },
      "acceptees": [
        "5000",
        "5 000",
        "5 000 L"
      ],
      "explication": {
        "fr": "1 m³ = 1 000 L → 5 000 L.",
        "ar": "1 م³ = 1 000 لتر ← 5 000 لتر."
      }
    },
    {
      "id": "q5",
      "type": "vf",
      "q": {
        "fr": "Le volume s'exprime en unités cubiques (cm³, m³).",
        "ar": "يُقاس الحجم بوحدات مكعبة (سم³، م³)."
      },
      "bonne": true,
      "explication": {
