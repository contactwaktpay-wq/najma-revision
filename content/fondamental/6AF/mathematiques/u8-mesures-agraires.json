        "ar": "وحدة مساحة: 1 آر = 100 م²."
      }
    },
    {
      "terme": {
        "fr": "Hectare (ha)",
        "ar": "الهكتار"
      },
      "def": {
        "fr": "Grande unité agraire : 1 ha = 100 ares = 10 000 m².",
        "ar": "وحدة فلاحية كبيرة: 1 هكتار = 100 آر = 10 000 م²."
      }
    },
    {
      "terme": {
        "fr": "Centiare (ca)",
        "ar": "السنتيار"
      },
      "def": {
        "fr": "1 centiare = 1 m².",
        "ar": "1 سنتيار = 1 م²."
      }
    },
    {
      "terme": {
        "fr": "Périmètre irrigué",
        "ar": "الحيّز المسقي"
      },
      "def": {
        "fr": "Zone agricole aménagée pour l'irrigation (fleuve Sénégal).",
        "ar": "منطقة فلاحية مهيأة للسقي (نهر السنغال)."
      }
    },
    {
      "terme": {
        "fr": "Rendement",
        "ar": "الإنتاجية"
      },
      "def": {
        "fr": "Quantité produite par hectare (t/ha).",
        "ar": "الكمية المنتجة لكل هكتار (طن/هكتار)."
      }
    }
  ],
  "exercices": [
    {
      "id": "e1",
      "niveau_diff": 1,
      "enonce": {
        "fr": "Convertis : 250 m² en ares et centiares.",
        "ar": "حوّل: 250 م² إلى آر وسنتيار."
      },
      "correction": {
        "etapes": [
          {
            "fr": "250 ÷ 100 = 2 ares, reste 50 m² = 50 ca.",
            "ar": "250 ÷ 100 = 2 آر ويتبقى 50 م² = 50 سنتيار."
          }
        ],
        "resultat": {
          "fr": "2 a 50 ca",
          "ar": "2 آر و50 سنتيار"
        }
      }
    },
    {
      "id": "e2",
      "niveau_diff": 1,
      "enonce": {
        "fr": "Convertis : 4 ha en ares puis en m².",
        "ar": "حوّل: 4 هكتار إلى آر ثم إلى م²."
      },
      "correction": {
        "etapes": [
          {
            "fr": "4 × 100 = 400 ares.",
            "ar": "4 × 100 = 400 آر."
          },
          {
            "fr": "400 × 100 = 40 000 m².",
            "ar": "400 × 100 = 40 000 م²."
          }
        ],
        "resultat": {
          "fr": "400 a ; 40 000 m²",
          "ar": "400 آر؛ 40 000 م²"
        }
      }
    },
    {
      "id": "e3",
      "niveau_diff": 2,
      "enonce": {
        "fr": "Un terrain mesure 120 m sur 80 m. Exprime son aire en m², ares et hectares.",
        "ar": "أرض 120 م × 80 م. عبّر عن مساحتها بالمتر المربع والآر والهكتار."
      },
      "correction": {
        "etapes": [
          {
            "fr": "A = 120 × 80 = 9 600 m².",
            "ar": "المساحة = 9 600 م²."
          },
          {
            "fr": "9 600 ÷ 100 = 96 ares.",
            "ar": "9 600 ÷ 100 = 96 آر."
          },
          {
            "fr": "96 ÷ 100 = 0,96 ha.",
            "ar": "96 ÷ 100 = 0,96 هكتار."
          }
        ],
        "resultat": {
          "fr": "9 600 m² = 96 a = 0,96 ha",
          "ar": "9 600 م² = 96 آر = 0,96 هكتار"
        }
      }
    },
    {
      "id": "e4",
      "niveau_diff": 3,
      "enonce": {
        "fr": "Problème : Un lotissement vend le terrain de 0,5 ha au prix de 15 000 MRU l'are. Quel est le prix total ?",
        "ar": "مسألة: يُباع أرض 0,5 هكتار بثمن 15 000 أوقية للآر. ما الثمن الكلي؟"
      },
      "correction": {
        "etapes": [
          {
            "fr": "0,5 ha = 50 ares.",
            "ar": "0,5 هكتار = 50 آر."
          },
          {
            "fr": "50 × 15 000 = 750 000 MRU.",
            "ar": "50 × 15 000 = 750 000 أوقية."
          }
        ],
        "resultat": {
          "fr": "750 000 MRU",
          "ar": "750 000 أوقية"
        }
      },
      "acceptees": [
        "750000"
      ]
    },
    {
      "id": "e5",
      "niveau_diff": 3,
      "enonce": {
        "fr": "Problème : Un champ de riz de 2 ha produit 3,5 tonnes par hectare. Le riz est mis en sacs de 50 kg. Combien de sacs ?",
        "ar": "مسألة: حقل أرز 2 هكتار ينتج 3,5 طن في الهكتار. يُوضع الأرز في أكياس من 50 كلغ. كم كيساً؟"
      },
      "correction": {
        "etapes": [
          {
            "fr": "Production : 2 × 3,5 = 7 t = 7 000 kg.",
            "ar": "الإنتاج = 2 × 3,5 = 7 طن = 7 000 كلغ."
          },
          {
            "fr": "Sacs : 7 000 ÷ 50 = 140 sacs.",
            "ar": "الأكياس = 7 000 ÷ 50 = 140 كيساً."
          }
        ],
        "resultat": {
          "fr": "140 sacs",
          "ar": "140 كيساً"
        }
      },
      "acceptees": [
        "140"
      ]
    }
  ],
