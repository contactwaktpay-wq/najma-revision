  "id": "6AF-math-08",
  "niveau": "6AF",
  "matiere": "mathematiques",
  "ordre": 8,
  "titre": {
    "fr": "Mesures agraires : ares, hectares",
    "ar": "القياسات الفلاحية: الآر والهكتار"
  },
  "duree_min": 45,
  "objectifs": {
    "fr": [
      "Connaître l'are, le centiare et l'hectare",
      "Convertir entre m², ares et hectares",
      "Résoudre des problèmes de terres agricoles (rendement, prix)"
    ],
    "ar": [
      "معرفة الآر والسنتيار والهكتار",
      "التحويل بين م² والآر والهكتار",
      "حل مسائل الأراضي الفلاحية (الإنتاج، الثمن)"
    ]
  },
  "fiche": [
    {
      "titre": {
        "fr": "Les unités de terres agricoles",
        "ar": "وحدات قياس الأراضي الفلاحية"
      },
      "puces": [
        {
          "fr": "1 centiare (ca) = 1 m² : c'est l'unité la plus petite.",
          "ar": "1 سنتيار (ca) = 1 م²: وهي أصغر وحدة."
        },
        {
          "fr": "1 are (a) = 100 m² : un carré de 10 m sur 10 m.",
          "ar": "1 آر (a) = 100 م²: مربع 10 م × 10 م."
        },
        {
          "fr": "1 hectare (ha) = 100 ares = 10 000 m² : un carré de 100 m sur 100 m.",
          "ar": "1 هكتار (ha) = 100 آر = 10 000 م²: مربع 100 م × 100 م."
        },
        {
          "fr": "Les paysans du fleuve Sénégal (Rosso, Kaédi) mesurent leurs périmètres irrigués en hectares.",
          "ar": "يقيس الفلاحون بجهة نهر السنغال (روصو، كيهيدي) حقولهم المسقية بالهكتار."
        }
      ],
      "tableau": {
        "entetes": {
          "fr": [
            "Unité",
            "Valeur"
          ],
          "ar": [
            "الوحدة",
            "القيمة"
          ]
        },
        "lignes": [
          {
            "fr": [
              "1 centiare (ca)",
              "1 m²"
            ],
            "ar": [
              "1 سنتيار",
              "1 م²"
            ]
          },
          {
            "fr": [
              "1 are (a)",
              "100 m² = 100 ca"
            ],
            "ar": [
              "1 آر",
              "100 م² = 100 سنتيار"
            ]
          },
          {
            "fr": [
              "1 hectare (ha)",
              "100 ares = 10 000 m²"
            ],
            "ar": [
              "1 هكتار",
              "100 آر = 10 000 م²"
            ]
          }
        ]
      }
    },
    {
      "titre": {
        "fr": "Convertir sans erreur",
        "ar": "التحويل بلا خطأ"
      },
      "puces": [
        {
          "fr": "m² → ares : diviser par 100. Ares → m² : multiplier par 100.",
          "ar": "م² ← آر: نقسم على 100. آر ← م²: نضرب في 100."
        },
        {
          "fr": "ares → hectares : diviser par 100. Hectares → ares : multiplier par 100.",
          "ar": "آر ← هكتار: نقسم على 100. هكتار ← آر: نضرب في 100."
        },
        {
          "fr": "Exemple : 2,5 ha = 250 ares = 25 000 m².",
          "ar": "مثال: 2,5 هكتار = 250 آر = 25 000 م²."
        }
      ],
      "formules": [
        {
          "fr": "1 ha = 100 a",
          "ar": "1 هكتار = 100 آر"
        },
        {
          "fr": "1 a = 100 ca (m²)",
          "ar": "1 آر = 100 سنتيار (م²)"
        },
        {
          "fr": "A d'un rectangle = L × l (en m²) → ares = m² ÷ 100",
          "ar": "مساحة المستطيل = ط × ع (م²) ← الآر = م² ÷ 100"
        }
      ]
    },
    {
      "titre": {
        "fr": "Problèmes typiques du terrain",
        "ar": "مسائل نموذجية من الواقع"
      },
      "puces": [
        {
          "fr": "Parcelle de 50 m sur 20 m : A = 1 000 m² = 10 ares = 0,1 ha.",
          "ar": "قطعة 50 م × 20 م: المساحة = 1 000 م² = 10 آر = 0,1 هكتار."
        },
        {
          "fr": "Champ de riz de 3 ha : rendement 4 t/ha → 3 × 4 = 12 tonnes de riz.",
          "ar": "حقل أرز 3 هكتار: الإنتاج 4 طن/هكتار ← 3 × 4 = 12 طن من الأرز."
        },
        {
          "fr": "Un jardin d'oasis de 0,5 ha = 5 000 m² peut nourrir une famille.",
          "ar": "حديقة واحة 0,5 هكتار = 5 000 م² تكفي لتغذية عائلة."
        }
      ]
    }
  ],
  "definitions": [
    {
