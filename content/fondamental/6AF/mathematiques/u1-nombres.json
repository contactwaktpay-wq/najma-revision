        "ar": "الجزء الصحيح من الجزء العشري."
      }
    },
    {
      "id": "f4",
      "recto": {
        "fr": "Nomme les 3 classes d'un grand nombre",
        "ar": "اذكر أصناف العدد الكبير الثلاثة"
      },
      "verso": {
        "fr": "Unités, milliers, millions.",
        "ar": "الوحدات، الآلاف، الملايين."
      }
    },
    {
      "id": "f5",
      "recto": {
        "fr": "3,50 = ?",
        "ar": "3,50 = ؟"
      },
      "verso": {
