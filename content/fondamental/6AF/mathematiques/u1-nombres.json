        "ar": "أول رقم بعد الفاصلة = الأعشار."
      }
    },
    {
      "id": "q7",
      "type": "vf",
      "q": {
        "fr": "99 999 < 100 000.",
        "ar": "99 999 < 100 000."
      },
      "bonne": true,
      "explication": {
        "fr": "Vrai : 100 000 est 1 de plus.",
        "ar": "صحيح: الفرق 1."
      }
    },
    {
      "id": "q8",
      "type": "calcul",
      "q": {
        "fr": "Combien de dizaines dans 340 ?",
        "ar": "كم عشرات في 340؟"
      },
      "acceptees": [
        "34"
      ],
      "explication": {
        "fr": "340 ÷ 10 = 34.",
        "ar": "340 ÷ 10 = 34."
      }
    }
  ],
  "flashcards": [
    {
      "id": "f1",
      "recto": {
        "fr": "Comment compare-t-on deux nombres décimaux ?",
        "ar": "كيف نقارن عددين عشريين؟"
      },
      "verso": {
        "fr": "Parties entières d'abord, puis décimales chiffre par chiffre.",
        "ar": "الأجزاء الصحيحة أولاً ثم الأرقام العشرية رقماً برقم."
      }
    },
    {
      "id": "f2",
      "recto": {
        "fr": "Règle d'arrondi",
        "ar": "قاعدة التقريب"
      },
      "verso": {
        "fr": "Chiffre suivant ≥ 5 → +1 ; sinon on garde.",
        "ar": "الرقم الموالي ≥ 5 ← نزيد 1، وإلا نُبقيه."
      }
    },
    {
      "id": "f3",
      "recto": {
        "fr": "Que sépare la virgule ?",
        "ar": "ماذا تفصل الفاصلة؟"
      },
