      },
      "verso": {
        "fr": "Écrire le nombre avant et après : 999 et 1 001 encadrent 1 000.",
        "ar": "كتابة العددين قبله وبعده: 999 و 1 001."
      }
    },
    {
      "id": "f8",
      "recto": {
        "fr": "1 milliard = ?",
