{
  "schema": "sehil.unit@1",
  "statut": "PUBLIE",
  "id": "6AF-math-05",
  "niveau": "6AF",
  "matiere": "mathematiques",
  "ordre": 5,
  "titre": {
    "fr": "Géométrie : droites, angles et figures",
    "ar": "الهندسة: المستقيمات والزوايا والأشكال"
  },
  "duree_min": 30,
  "objectifs": {
    "fr": [
      "Reconnaître droites perpendiculaires et parallèles, mesurer et classer des angles",
      "Décrire triangles, quadrilatères et cercle (rayon, diamètre)",
      "Utiliser la symétrie axiale"
    ],
    "ar": [
      "التعرف على المستقيمات المتعامدة والمتوازية، وقياس الزوايا وتصنيفها",
      "وصف المثلثات والمضلعات الرباعية والدائرة (نصف القطر والقطر)",
      "استعمال التناظر المحوري"
    ]
  },
  "fiche": [
    {
      "titre": {
        "fr": "Droites et angles",
        "ar": "المستقيمات والزوايا"
      },
      "puces": [
        {
          "fr": "Deux droites perpendiculaires forment un angle droit (90°).",
          "ar": "المستقيمان المتعامدان يشكلان زاوية قائمة (90°)."
        },
        {
          "fr": "Deux droites parallèles ne se croisent jamais.",
          "ar": "المستقيمان المتوازيان لا يتقاطعان أبداً."
        },
        {
          "fr": "Angle aigu : moins de 90° ; angle obtus : entre 90° et 180°.",
          "ar": "الزاوية الحادة: أقل من 90°؛ الزاوية المنفرجة: بين 90° و 180°."
        }
      ],
      "formules": [
        "angle droit = 90°",
        "somme des angles d'un triangle = 180°"
      ]
    },
    {
      "titre": {
        "fr": "Polygones usuels",
        "ar": "المضلعات المألوفة"
      },
      "puces": [
        {
          "fr": "Triangle rectangle : possède un angle droit. Triangle équilatéral : 3 côtés égaux, 3 angles de 60°.",
          "ar": "المثلث القائم: له زاوية قائمة. المثلث المتساوي الأضلاع: 3 أضلاع متساوية و3 زوايا بحجم 60°."
        },
        {
          "fr": "Carré : 4 côtés égaux, 4 angles droits. Rectangle : côtés opposés égaux, 4 angles droits.",
          "ar": "المربع: 4 أضلاع متساوية و4 زوايا قائمة. المستطيل: الأضلاع المتقابلة متساوية و4 زوايا قائمة."
        },
        {
          "fr": "Cercle : le rayon va du centre au cercle ; le diamètre = 2 × rayon.",
          "ar": "الدائرة: نصف القطر يمتد من المركز إلى الدائرة؛ والقطر = 2 × نصف القطر."
        }
      ],
      "exemple": {
        "enonce": {
          "fr": "Un cercle a un rayon de 4 cm. Quel est son diamètre ?",
          "ar": "دائرة نصف قطرها 4 سم. ما قطرها؟"
        },
        "etapes": [
          {
            "fr": "Diamètre = 2 × rayon = 2 × 4.",
            "ar": "القطر = 2 × نصف القطر = 2 × 4."
          }
        ],
        "resultat": {
          "fr": "8 cm",
          "ar": "8 سم"
        }
      }
    },
    {
      "titre": {
        "fr": "Symétrie axiale",
        "ar": "التناظر المحوري"
      },
      "bloc": [
        {
          "fr": "Un point et son symétrique par rapport à un axe sont à la même distance de cet axe, sur la même perpendiculaire. Les figures du quotidien (papillons, tuiles) sont souvent symétriques.",
          "ar": "النقطة ونظيرتها بالنسبة إلى محور تبعدان المسافة نفسه عنه، على نفس المستقيم المتعامد. كثير من الأشكال اليومية (الفراشة، البلاط) متناظرة."
        }
      ]
    }
  ],
  "definitions": [
    {
      "terme": {
        "fr": "Angle droit",
        "ar": "الزاوية القائمة"
      },
      "def": {
        "fr": "Angle de 90°, marqué d'un petit carré.",
        "ar": "زاوية بحجم 90°، تُرمز بمربع صغير."
      }
    },
    {
      "terme": {
        "fr": "Rayon",
        "ar": "نصف القطر"
      },
      "def": {
        "fr": "Segment du centre du cercle à un point du cercle.",
        "ar": "القطعة الممتدة من مركز الدائرة إلى نقطة عليها."
      }
    },
    {
      "terme": {
        "fr": "Diamètre",
        "ar": "القطر"
      },
      "def": {
        "fr": "Corde passant par le centre : le plus grand segment du cercle.",
        "ar": "الوتر المار بالمركز: أكبر قطعة في الدائرة."
      }
    },
    {
      "terme": {
        "fr": "Axe de symétrie",
        "ar": "محور التناظر"
      },
      "def": {
        "fr": "Droite qui partage une figure en deux parties superposables.",
        "ar": "المستقيم الذي يقسم الشكل إلى جزأين متطابقين."
      }
    }
  ],
  "exercices": [
    {
      "id": "e1",
      "niveau_diff": 1,
      "enonce": {
        "fr": "Trace un segment AB de 5 cm puis, au compas, un cercle de centre A passant par B. Quel est le rayon ?",
        "ar": "ارسم قطعة AB طولها 5 سم ثم ارسم ببركار دائرة مركزها A تمر بـ B. ما نصف القطر؟"
      },
      "correction": {
        "etapes": [
          {
            "fr": "Le cercle passe par B et son centre est A : rayon = AB = 5 cm.",
            "ar": "الدائرة تمر بـ B ومركزها A: نصف القطر = AB = 5 سم."
          }
        ],
        "resultat": {
          "fr": "5 cm",
          "ar": "5 سم"
        }
      },
      "acceptees": [
        "5"
      ]
    },
    {
      "id": "e2",
      "niveau_diff": 2,
      "enonce": {
        "fr": "Dans un triangle, deux angles mesurent 65° et 45°. Mesure du 3e angle ?",
        "ar": "في مثلث يبلغ قياس زاويتين 65° و 45°. ما قياس الزاوية الثالثة؟"
      },
      "correction": {
        "etapes": [
          {
            "fr": "180 − (65 + 45) = 180 − 110 = 70.",
            "ar": "180 − (65 + 45) = 180 − 110 = 70."
          }
        ],
        "resultat": {
          "fr": "70°",
          "ar": "70°"
        }
      },
      "acceptees": [
        "70"
      ]
    },
    {
      "id": "e3",
      "niveau_diff": 3,
      "enonce": {
        "fr": "Un rectangle a un périmètre de 24 cm et une longueur de 8 cm. Quelle est sa largeur ?",
        "ar": "مستطيل محيطه 24 سم وطوله 8 سم. ما عرضه؟"
      },
      "correction": {
        "etapes": [
          {
            "fr": "P = (L + l) × 2 → L + l = 12 ; l = 12 − 8 = 4.",
            "ar": "P = (L + l) × 2 ← L + l = 12 ؛ l = 12 − 8 = 4."
          }
        ],
        "resultat": {
          "fr": "4 cm",
          "ar": "4 سم"
        }
      },
      "acceptees": [
        "4"
      ]
    },
    {
      "id": "e4",
      "niveau_diff": 2,
      "enonce": {
        "fr": "Un cercle a un rayon de 6 cm. Quel est son diamètre ? Et si le diamètre est 20 cm, quel est le rayon ?",
        "ar": "دائرة نصف قطرها 6 سم. ما قطرها؟ وإذا كان القطر 20 سم فما نصف القطر؟"
      },
      "correction": {
        "etapes": [
          {
            "fr": "Diamètre = 2 × rayon = 12 cm.",
            "ar": "القطر = 2 × نصف القطر = 12 سم."
          },
          {
            "fr": "Rayon = diamètre ÷ 2 = 10 cm.",
            "ar": "نصف القطر = 10 سم."
          }
        ],
        "resultat": {
          "fr": "12 cm ; 10 cm",
          "ar": "12 سم؛ 10 سم"
        }
      }
    },
    {
      "id": "e5",
      "niveau_diff": 3,
      "enonce": {
        "fr": "Vrai ou faux, puis justifie : « Deux droites qui ne se coupent pas sont toujours parallèles. »",
        "ar": "صواب أو خطأ مع التعليل: «المستقيمان اللذان لا يتقاطعان متوازيان دائماً»."
      },
      "correction": {
        "etapes": [
          {
            "fr": "Faux : dans le plan oui, mais il faut préciser qu’elles sont dans le même plan.",
            "ar": "خطأ: يجب أن يكونا في المستوى نفسه."
          }
        ],
        "resultat": {
          "fr": "Faux (même plan requis)",
          "ar": "خطأ (المستوى نفسه)"
        }
      }
    }
  ],
