      ],
      "explication": {
        "fr": "14 ÷ 2 = 7 cm.",
        "ar": "14 ÷ 2 = 7 سم."
      }
    },
    {
      "id": "q8",
      "type": "vf",
      "q": {
        "fr": "Un carré a 4 angles droits.",
        "ar": "للمربع 4 زوايا قائمة."
      },
      "bonne": true,
      "explication": {
        "fr": "Vrai.",
        "ar": "صحيح."
      }
    }
  ],
