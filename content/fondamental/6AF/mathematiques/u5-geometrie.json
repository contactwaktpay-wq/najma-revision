      }
    },
    {
      "id": "q4",
      "type": "qcm",
      "q": {
        "fr": "Le carré possède combien d'axes de symétrie ?",
        "ar": "كم عدد محاور تناظر المربع؟"
      },
      "choix": [
        {
          "fr": "4",
          "ar": "4"
        },
        {
          "fr": "2",
