    },
    {
      "id": "q5",
      "type": "qcm",
      "q": {
        "fr": "Deux droites parallèles…",
        "ar": "المستقيمان المتوازيان…"
      },
      "choix": [
        {
          "fr": "ne se croisent jamais",
          "ar": "لا يتقاطعان أبداً"
        },
        {
          "fr": "forment un angle droit",
          "ar": "يشكلان زاوية قائمة"
        },
        {
          "fr": "se coupent en un point",
          "ar": "يتقاطعان في نقطة"
        }
      ],
      "bonne": 0,
