      }
    },
    {
      "id": "q6",
      "type": "courte",
      "q": {
        "fr": "Triangle équilatéral : mesure de chaque angle ?",
        "ar": "المثلث المتساوي الأضلاع: ما قياس كل زاوية؟"
      },
      "acceptees": [
        "60",
        "60°",
        "60 deg"
      ],
      "explication": {
        "fr": "180 ÷ 3.",
        "ar": "180 ÷ 3."
      }
