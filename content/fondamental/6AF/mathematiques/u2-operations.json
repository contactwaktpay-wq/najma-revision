{
  "schema": "sehil.unit@1",
  "statut": "PUBLIE",
  "id": "6AF-math-02",
  "niveau": "6AF",
  "matiere": "mathematiques",
  "ordre": 2,
  "titre": {
    "fr": "Les quatre opérations et les multiples",
    "ar": "العمليات الأربع والمضاعفات"
  },
  "duree_min": 30,
  "objectifs": {
    "fr": [
      "Poser et maîtriser addition, soustraction et multiplication",
      "Connaître la division euclidienne (quotient et reste)",
      "Utiliser les multiples, diviseurs et critères de divisibilité"
    ],
    "ar": [
      "إنجاز الجمع والطرح والضرب بإتقان",
      "استعمال القسمة الإقليدية (الحاصل والباقي)",
      "استعمال المضاعفات والقواسم وقابلية القسمة"
    ]
  },
  "fiche": [
    {
      "titre": {
        "fr": "Techniques opératoires",
        "ar": "تقنيات العمليات"
      },
      "puces": [
        {
          "fr": "Addition : on aligne les unités sous les unités, puis on additionne colonne par colonne avec les retenues.",
          "ar": "الجمع: نوائم الوحدات تحت الوحدات ثم نجمع عموداً بعمود مع الحفظ."
        },
        {
          "fr": "Soustraction : même alignement ; on vérifie le résultat par une addition (a − b + b = a).",
          "ar": "الطرح: نفس التواائم؛ نتحقق من الناتج بالجمع (a − b + b = a)."
        },
        {
          "fr": "Multiplication : on multiplie par chaque chiffre du multiplicateur, en décalant d'une colonne à chaque ligne.",
          "ar": "الضرب: نضرب في كل رقم من المضرب فيه مع تزحزح عمود لكل سطر."
        }
      ],
      "exemple": {
        "enonce": {
          "fr": "Calcule 4 086 + 2 957, puis 64 × 25.",
          "ar": "احسب 4 086 + 2 957 ثم 64 × 25."
        },
        "etapes": [
          {
            "fr": "Addition : 6+7=13 (pose 3, retenue 1) ; 8+5+1=14 ; 0+9+1=10 ; 4+2+1=7 → 7 043.",
            "ar": "الجمع: 6+7=13 (نكتب 3 ونحفظ 1) ؛ 8+5+1=14 ؛ 0+9+1=10 ؛ 4+2+1=7 ← 7 043."
          },
          {
            "fr": "Multiplication : 64 × 25 = 64 × 100 ÷ 4 = 6 400 ÷ 4 = 1 600.",
            "ar": "الضرب: 64 × 25 = 64 × 100 ÷ 4 = 6 400 ÷ 4 = 1 600."
          }
        ],
        "resultat": {
          "fr": "4 086 + 2 957 = 7 043 ; 64 × 25 = 1 600",
          "ar": "4 086 + 2 957 = 7 043 ؛ 64 × 25 = 1 600"
        }
      }
    },
    {
      "titre": {
        "fr": "La division euclidienne",
        "ar": "القسمة الإقليدية"
      },
      "bloc": [
        {
          "fr": "Diviser 83 par 7, c'est chercher le plus grand quotient possible et un reste : 83 = 7 × 11 + 6. Le reste est toujours inférieur au diviseur.",
          "ar": "قسمة 83 على 7 هي البحث عن أكبر حاصل ممكن وباقٍ: 83 = 7 × 11 + 6. الباقي دائماً أصغر من القاسم."
        }
      ],
      "formules": [
        "dividende = diviseur × quotient + reste",
        "reste < diviseur"
      ]
    },
    {
      "titre": {
        "fr": "Multiples, diviseurs et divisibilité",
        "ar": "المضاعفات والقواسم وقابلية القسمة"
      },
      "puces": [
        {
          "fr": "Divisibilité par 2 : le chiffre des unités est 0, 2, 4, 6 ou 8.",
          "ar": "القسمة على 2: رقم الوحدات هو 0 أو 2 أو 4 أو 6 أو 8."
        },
        {
          "fr": "Divisibilité par 5 : le chiffre des unités est 0 ou 5.",
          "ar": "القسمة على 5: رقم الوحدات هو 0 أو 5."
        },
        {
          "fr": "Divisibilité par 3 (ou 9) : la somme des chiffres est divisible par 3 (ou par 9).",
          "ar": "القسمة على 3 (أو 9): مجموع الأرقام يقبل القسمة على 3 (أو 9)."
        },
        {
          "fr": "Divisibilité par 10 : le chiffre des unités est 0.",
          "ar": "القسمة على 10: رقم الوحدات هو 0."
        }
      ],
      "exemple": {
        "enonce": {
          "fr": "1 275 est-il divisible par 3 ? par 5 ? par 9 ?",
          "ar": "هل العدد 1 275 يقبل القسمة على 3؟ على 5؟ على 9؟"
        },
        "etapes": [
          {
            "fr": "Somme des chiffres : 1+2+7+5 = 15 ; 15 est divisible par 3 mais pas par 9.",
            "ar": "مجموع الأرقام: 1+2+7+5 = 15 ؛ 15 يقبل القسمة على 3 لكن ليس على 9."
          },
          {
            "fr": "Le chiffre des unités est 5 → divisible par 5.",
            "ar": "رقم الوحدات هو 5 ← يقبل القسمة على 5."
          }
        ],
        "resultat": {
          "fr": "Oui par 3 et par 5 ; non par 9.",
          "ar": "نعم على 3 وعلى 5 ؛ لا على 9."
        }
      }
    }
  ],
  "definitions": [
    {
      "terme": {
        "fr": "Multiple",
        "ar": "مضاعف"
      },
      "def": {
        "fr": "12 est un multiple de 3 car 12 = 3 × 4.",
        "ar": "12 مضاعف للعدد 3 لأن 12 = 3 × 4."
      }
    },
    {
      "terme": {
        "fr": "Diviseur",
        "ar": "قاسم"
      },
      "def": {
        "fr": "3 est un diviseur de 12 car la division tombe juste.",
        "ar": "3 قاسم للعدد 12 لأن القسمة تنقسم تماماً."
      }
    },
    {
      "terme": {
        "fr": "Quotient / reste",
        "ar": "الحاصل / الباقي"
      },
      "def": {
        "fr": "Résultat entier de la division euclidienne / ce qui n'a pas pu être divisé.",
        "ar": "الناتج الصحيح للقسمة الإقليدية / ما لم يقبل القسمة."
      }
    },
    {
      "terme": {
        "fr": "Ordre de grandeur",
        "ar": "الرتبة الكبرى للتقدير"
      },
      "def": {
        "fr": "Approximation rapide qui permet de vérifier un calcul (ex. 2 957 ≈ 3 000).",
        "ar": "تقريب سريع للتحقق من عملية حسابية (مثال: 2 957 ≈ 3 000)."
      }
    }
  ],
  "exercices": [
    {
      "id": "e1",
      "niveau_diff": 1,
      "enonce": {
        "fr": "Pose et calcule : 7 305 − 2 876.",
        "ar": "أجرِ العملية واحسب: 7 305 − 2 876."
      },
      "correction": {
        "etapes": [
          {
            "fr": "Alignement puis soustraction avec retenues.",
            "ar": "التواائم ثم الطرح مع الحفظ."
          }
        ],
        "resultat": {
          "fr": "4 429",
          "ar": "4 429"
        }
      },
      "acceptees": [
        "4429"
      ]
    },
    {
      "id": "e2",
      "niveau_diff": 2,
      "enonce": {
        "fr": "Effectue la division euclidienne de 95 par 6.",
        "ar": "أجرِ القسمة الإقليدية للعدد 95 على 6."
      },
      "correction": {
        "etapes": [
          {
            "fr": "6 × 15 = 90 ; 95 − 90 = 5 ; reste 5 < 6.",
            "ar": "6 × 15 = 90 ؛ 95 − 90 = 5 ؛ الباقي 5 < 6."
          }
        ],
        "resultat": {
          "fr": "quotient 15, reste 5",
          "ar": "الحاصل 15 والباقي 5"
        }
      }
    },
    {
      "id": "e3",
      "niveau_diff": 3,
      "enonce": {
        "fr": "Une librairie reçoit 240 cahiers et les met en paquets égaux de 8. Combien de paquets ? Reste-t-il des cahiers ?",
        "ar": "استلمت مكتبة 240 كراساً ورتبتها في حزم متساوية من 8. كم حزمة؟ وهل بقيت كراسات؟"
      },
      "correction": {
        "etapes": [
          {
            "fr": "240 ÷ 8 = 30, reste 0 → division exacte.",
            "ar": "240 ÷ 8 = 30 والباقي 0 ← قسمة تمامية."
          }
        ],
        "resultat": {
          "fr": "30 paquets, aucun reste.",
          "ar": "30 حزمة وبلا بقيّة."
        }
      }
    },
    {
      "id": "e4",
      "niveau_diff": 2,
      "enonce": {
        "fr": "Calcule en réfléchi : 25 × 8 ; 498 + 997.",
        "ar": "احسب بذكاء: 25 × 8؛ 498 + 997."
      },
      "correction": {
        "etapes": [
          {
            "fr": "25 × 8 = 25 × 4 × 2 = 100 × 2 = 200.",
            "ar": "25 × 8 = 200."
          },
          {
            "fr": "498 + 997 = 500 + 1 000 − 2 − 3 = 1 495.",
            "ar": "498 + 997 = 1 495."
          }
        ],
        "resultat": {
          "fr": "200 ; 1 495",
          "ar": "200؛ 1 495"
        }
      }
    },
    {
      "id": "e5",
      "niveau_diff": 3,
      "enonce": {
        "fr": "Problème : L’école achète 8 paquets de 25 cahiers à 175 MRU le cahier. Coût total ?",
        "ar": "مسألة: تشتري المدرسة 8 حزم من 25 كراساً بـ 175 أوقية للكراس. ما الكلفة الكلية؟"
      },
      "correction": {
        "etapes": [
          {
            "fr": "Cahiers : 8 × 25 = 200 cahiers.",
            "ar": "الكراسات: 8 × 25 = 200 كراس."
          },
          {
            "fr": "Coût : 200 × 175 = 35 000 MRU.",
            "ar": "الكلفة: 200 × 175 = 35 000 أوقية."
          }
        ],
        "resultat": {
          "fr": "35 000 MRU",
          "ar": "35 000 أوقية"
        }
      },
      "acceptees": [
        "35000"
      ]
    }
  ],
