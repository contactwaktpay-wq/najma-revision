      },
      "verso": {
        "fr": "F′ = f.",
        "ar": "F′ = f."
      }
    },
    {
      "id": "f2",
      "recto": {
        "fr": "∫ₐᵇ f(x) dx",
        "ar": "∫ₐᵇ f(x) dx"
      },
      "verso": {
        "fr": "F(b) − F(a).",
        "ar": "F(b) − F(a)."
      }
    },
    {
      "id": "f3",
      "recto": {
        "fr": "Primitive de xⁿ",
        "ar": "دالة أصلية لـ xⁿ"
      },
      "verso": {
        "fr": "xⁿ⁺¹/(n+1).",
        "ar": "xⁿ⁺¹/(n+1)."
      }
    },
    {
      "id": "f4",
      "recto": {
        "fr": "Primitive de eˣ",
        "ar": "دالة أصلية لـ eˣ"
      },
      "verso": {
        "fr": "eˣ.",
        "ar": "eˣ."
      }
    },
    {
      "id": "f5",
      "recto": {
        "fr": "Linéarité de l'intégrale",
        "ar": "خطية التكامل"
      },
      "verso": {
        "fr": "∫(f+g) = ∫f + ∫g ; ∫kf = k∫f.",
        "ar": "∫(f+g) = ∫f + ∫g ؛ ∫kf = k∫f."
      }
    },
    {
      "id": "f6",
      "recto": {
