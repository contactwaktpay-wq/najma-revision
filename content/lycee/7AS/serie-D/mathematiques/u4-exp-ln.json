{
  "schema": "sehil.unit@1",
  "statut": "A_RELIRE",
  "id": "7ASD-math-04",
  "niveau": "7AS",
  "matiere": "mathematiques",
  "ordre": 4,
  "titre": {
    "fr": "Fonctions logarithme népérien et exponentielle",
    "ar": "الدالتان اللوغاريتمية النيبيرية والأسية"
  },
  "duree_min": 40,
  "objectifs": {
    "fr": [
      "Utiliser les propriétés algébriques de ln et exp",
      "Résoudre équations et inéquations avec ln et exp",
      "Connaître les limites et la dérivée de ces fonctions"
    ],
    "ar": [
      "استعمال الخصائص الجبرية للوغاريتم والأسية",
      "حل المعادلات والمتراجحات بالوغاريتم والأسية",
      "معرفة النهايات والمشتقات"
    ]
  },
  "fiche": [
    {
      "titre": {
        "fr": "Propriétés algébriques",
        "ar": "الخصائص الجبرية"
      },
      "formules": [
        "ln(ab) = ln a + ln b",
        "ln(a/b) = ln a − ln b",
        "ln(aⁿ) = n·ln a",
        "e^(a+b) = eᵃ × eᵇ",
        "e^(−a) = 1/eᵃ",
        "ln x = y ⇔ x = eʸ"
      ],
      "puces": [
        {
          "fr": "ln est définie sur ]0, +∞[ ; exp sur ℝ ; ln(e) = 1 ; ln(1) = 0.",
          "ar": "الدالة ln معرفة على ]0، +∞[ و exp على ℝ ؛ ln(e) = 1 ؛ ln(1) = 0."
        }
      ]
    },
    {
      "titre": {
        "fr": "Limites et dérivées",
        "ar": "النهايات والمشتقات"
      },
      "tableau": {
        "entetes": [
          {
            "fr": "f",
            "ar": "f"
          },
          {
            "fr": "Limites",
            "ar": "النهايات"
          },
          {
            "fr": "f′",
            "ar": "f′"
          }
        ],
        "lignes": [
          [
            "ln x",
            {
              "fr": "x→0⁺ : −∞ ; x→+∞ : +∞",
              "ar": "x→0⁺: −∞ ؛ x→+∞: +∞"
            },
            "1/x"
          ],
          [
            "eˣ",
            {
              "fr": "x→−∞ : 0 ; x→+∞ : +∞",
              "ar": "x→−∞: 0 ؛ x→+∞: +∞"
            },
            "eˣ"
          ]
        ]
      },
      "puces": [
        {
          "fr": "Croissance comparée : lim x→+∞ eˣ/xⁿ = +∞ et lim x→+∞ ln x/x = 0 (exp l'emporte sur les puissances, ln est négligeable devant x).",
          "ar": "المقارنة في النمو: exp تسود على القوى، و ln مهملة أمام x."
        }
      ],
      "exemple": {
        "enonce": {
          "fr": "Résous : ln(x + 2) = 3.",
          "ar": "حل المعادلة: ln(x + 2) = 3."
        },
        "etapes": [
          {
            "fr": "x + 2 = e³ (et x + 2 > 0 ✓).",
            "ar": "x + 2 = e³ (والشرط محقق)."
          },
          {
            "fr": "x = e³ − 2 ≈ 18,09.",
            "ar": "x = e³ − 2 ≈ 18,09."
          }
        ],
        "resultat": {
          "fr": "x = e³ − 2 ≈ 18,09",
          "ar": "x = e³ − 2 ≈ 18,09"
        }
      }
    },
    {
      "titre": {
        "fr": "Équations et inéquations",
        "ar": "المعادلات والمتراجحات"
      },
      "puces": [
        {
          "fr": "eᵃ = eᵇ ⇔ a = b ; eᵃ > 0 toujours. ln a = ln b ⇔ a = b (a, b > 0).",
          "ar": "eᵃ = eᵇ ⇔ a = b ؛ و eᵃ > 0 دائماً. ln a = ln b ⇔ a = b (a، b > 0)."
        },
        {
          "fr": "Domaine obligatoire : x > 0 pour ln avant toute résolution.",
          "ar": "المجال إلزامي: x > 0 لـ ln قبل أي حل."
        }
      ]
    }
  ],
  "definitions": [
    {
      "terme": {
        "fr": "ln",
        "ar": "اللوغاريتم النيبيري"
      },
      "def": {
        "fr": "Réciproque de exp : ln(eˣ) = x, e^(ln x) = x.",
        "ar": "الدالة العكسية للأسية: ln(eˣ) = x و e^(ln x) = x."
      }
    },
    {
      "terme": {
        "fr": "e",
        "ar": "العدد e"
      },
      "def": {
        "fr": "≈ 2,718 ; base de l'exponentielle naturelle.",
        "ar": "≈ 2,718؛ أساس الدالة الأسية الطبيعية."
      }
    },
    {
      "terme": {
        "fr": "Croissance comparée",
        "ar": "المقارنة في النمو"
      },
      "def": {
        "fr": "Comparaison des vitesses de croissance d'eˣ, xⁿ, ln x.",
        "ar": "مقارنة سرعات نمو الدوال."
      }
    }
  ],
  "exercices": [
    {
      "id": "e1",
      "niveau_diff": 1,
      "enonce": {
        "fr": "Simplifie : ln 8 + ln 2 − ln 4.",
        "ar": "بسّط: ln 8 + ln 2 − ln 4."
      },
      "correction": {
        "etapes": [
          {
            "fr": "ln(8×2/4) = ln 4.",
            "ar": "ln(8×2/4) = ln 4."
          }
        ],
        "resultat": {
          "fr": "ln 4",
          "ar": "ln 4"
        }
      },
      "acceptees": [
        "4"
      ]
    },
    {
      "id": "e2",
      "niveau_diff": 2,
      "enonce": {
        "fr": "Résous : e^(2x) = 5.",
        "ar": "حل: e^(2x) = 5."
      },
      "correction": {
        "etapes": [
          {
            "fr": "2x = ln 5 → x = (ln 5)/2.",
            "ar": "2x = ln 5 ← x = (ln 5)/2."
          }
        ],
        "resultat": {
          "fr": "x = (ln 5)/2 ≈ 0,80",
          "ar": "x = (ln 5)/2 ≈ 0,80"
        }
      }
    },
    {
      "id": "e3",
      "niveau_diff": 3,
      "enonce": {
        "fr": "Dérive f(x) = ln(x)/x.",
        "ar": "اشتق الدالة f(x) = ln(x)/x."
      },
      "correction": {
        "etapes": [
          {
            "fr": "(u/v)′ avec u = ln x, v = x : f′(x) = (1 − ln x)/x².",
            "ar": "بصيغة النسبة: f′(x) = (1 − ln x)/x²."
          }
        ],
        "resultat": {
          "fr": "(1 − ln x)/x²",
          "ar": "(1 − ln x)/x²"
        }
      },
      "acceptees": [
        "1"
      ]
    }
  ],
