{
  "schema": "sehil.unit@1",
  "statut": "PUBLIE",
  "id": "7ASD-math-02",
  "niveau": "7AS",
  "matiere": "mathematiques",
  "ordre": 2,
  "titre": {
    "fr": "Dérivation et étude de fonctions",
    "ar": "الاشتقاق ودراسة الدوال"
  },
  "duree_min": 40,
  "objectifs": {
    "fr": [
      "Calculer des dérivées (somme, produit, quotient)",
      "Lier le signe de la dérivée aux variations",
      "Établir le tableau de variations et déterminer les extremums"
    ],
    "ar": [
      "حساب المشتقات (مجموع، ضرب، نسبة)",
      "ربط إشارة المشتقة بالتغيرات",
      "إنشاء جدول التغيرات وتحديد الأطراف العليا والدنيا"
    ]
  },
  "fiche": [
    {
      "titre": {
        "fr": "Dérivées usuelles et opérations",
        "ar": "المشتقات الأساسية والعمليات"
      },
      "tableau": {
        "entetes": [
          {
            "fr": "f(x)",
            "ar": "f(x)"
          },
          {
            "fr": "f′(x)",
            "ar": "f′(x)"
          }
        ],
        "lignes": [
          [
            "xⁿ",
            "n·xⁿ⁻¹"
          ],
          [
            "1/x",
            "−1/x²"
          ],
          [
            "√x",
            "1/(2√x)"
          ],
          [
            "ln x",
            "1/x"
          ],
          [
            "eˣ",
            "eˣ"
          ],
          [
            "cos x",
            "−sin x"
          ],
          [
            "sin x",
            "cos x"
          ]
        ]
      },
      "formules": [
        "(u + v)′ = u′ + v′",
        "(u·v)′ = u′v + uv′",
        "(u/v)′ = (u′v − uv′)/v²",
        "(u∘v)′ = v′ × u′(v)"
      ]
    },
    {
      "titre": {
        "fr": "Signe de f′ et variations",
        "ar": "إشارة f′ والتغيرات"
      },
      "puces": [
        {
          "fr": "f′ > 0 sur un intervalle → f croissante ; f′ < 0 → f décroissante.",
          "ar": "إذا كانت f′ > 0 على مجال فـ f تزايدية؛ وإذا كانت f′ < 0 فـ f تناقصية."
        },
        {
          "fr": "Tangente en a : y = f′(a)(x − a) + f(a).",
          "ar": "المماس في a: y = f′(a)(x − a) + f(a)."
        },
        {
          "fr": "Extremum local : f′ s'annule et change de signe.",
          "ar": "الطرف المحلي: تنعدم f′ وتتغير إشارتها."
        }
      ],
      "exemple": {
        "enonce": {
          "fr": "f(x) = x³ − 3x + 1 : étudie les variations.",
          "ar": "f(x) = x³ − 3x + 1: ادرس التغيرات."
        },
        "etapes": [
          {
            "fr": "f′(x) = 3x² − 3 = 3(x − 1)(x + 1) : positif sur ]−∞, −1[ et ]1, +∞[, négatif sur ]−1, 1[.",
            "ar": "f′(x) = 3(x − 1)(x + 1): موجبة على المجالين السالبين وموجبة إشارةً خارج ]−1، 1[."
          },
          {
            "fr": "f croît puis décroît puis croît ; max local f(−1) = 3 ; min local f(1) = −1.",
            "ar": "f تزايدية ثم تناقصية ثم تزايدية؛ طرف علوي f(−1) = 3 وطرف سفلي f(1) = −1."
          }
        ],
        "resultat": {
          "fr": "Max local (−1 ; 3), min local (1 ; −1).",
          "ar": "طرف علوي (−1؛ 3) وطرف سفلي (1؛ −1)."
        }
      }
    },
    {
      "titre": {
        "fr": "Étude complète",
        "ar": "الدراسة الكاملة"
      },
      "puces": [
        {
          "fr": "Ensemble de définition → limites aux bornes et en ±∞ → dérivée, signe, tableau → asymptotes (verticale si lim = ±∞ en a ; horizontale si lim = L en ±∞) → tangentes particulières.",
          "ar": "مجموعة التعريف ← النهايات عند الأطراف ← المشتقة وإشارتها وجدول التغيرات ← المقاربات ← المماسات الخاصة."
        }
      ]
    }
  ],
  "definitions": [
    {
      "terme": {
        "fr": "Nombre dérivé",
        "ar": "العدد المشتق"
      },
      "def": {
        "fr": "lim h→0 (f(a+h) − f(a))/h ; pente de la tangente.",
        "ar": "نهاية (f(a+h) − f(a))/h؛ ميل المماس."
      }
    },
    {
      "terme": {
        "fr": "Tableau de variations",
        "ar": "جدول التغيرات"
      },
      "def": {
        "fr": "Résumé du sens de variation et des extremums.",
        "ar": "خلاصة اتجاه التغير والأطراف."
      }
    },
    {
      "terme": {
        "fr": "Asymptote",
        "ar": "المقارب"
      },
      "def": {
        "fr": "Droite dont la courbe se rapproche indéfiniment.",
        "ar": "مستقيم يقاربه منحنى الدالة دون توقف."
      }
    }
  ],
  "exercices": [
    {
      "id": "e1",
      "niveau_diff": 1,
      "enonce": {
        "fr": "Calcule la dérivée de f(x) = 3x² + 2x − 5.",
        "ar": "احسب مشتقة f(x) = 3x² + 2x − 5."
      },
      "correction": {
        "etapes": [
          {
            "fr": "f′(x) = 6x + 2.",
            "ar": "f′(x) = 6x + 2."
          }
        ],
        "resultat": {
          "fr": "6x + 2",
          "ar": "6x + 2"
        }
      }
    },
    {
      "id": "e2",
      "niveau_diff": 2,
      "enonce": {
        "fr": "Dérive f(x) = x²·eˣ.",
        "ar": "اشتق f(x) = x²·eˣ."
      },
      "correction": {
        "etapes": [
          {
            "fr": "(uv)′ : f′(x) = 2x·eˣ + x²·eˣ = eˣ(x² + 2x).",
            "ar": "(uv)′: f′(x) = eˣ(x² + 2x)."
          }
        ],
        "resultat": {
          "fr": "eˣ(x² + 2x)",
          "ar": "eˣ(x² + 2x)"
        }
      },
      "acceptees": [
        "2"
      ]
    },
    {
      "id": "e3",
      "niveau_diff": 3,
      "enonce": {
        "fr": "Équation de la tangente à f(x) = x² en a = 2.",
        "ar": "معادلة المماس لمنحنى f(x) = x² عند a = 2."
      },
      "correction": {
        "etapes": [
          {
            "fr": "f(2) = 4 ; f′(x) = 2x → f′(2) = 4.",
            "ar": "f(2) = 4 ؛ f′(2) = 4."
          },
          {
            "fr": "y = 4(x − 2) + 4 = 4x − 4.",
            "ar": "y = 4(x − 2) + 4 = 4x − 4."
          }
        ],
        "resultat": {
          "fr": "y = 4x − 4",
          "ar": "y = 4x − 4"
        }
      }
    }
  ],
