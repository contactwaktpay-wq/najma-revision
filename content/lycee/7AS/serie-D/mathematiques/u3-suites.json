{
  "schema": "sehil.unit@1",
  "statut": "PUBLIE",
  "id": "7ASD-math-03",
  "niveau": "7AS",
  "matiere": "mathematiques",
  "ordre": 3,
  "titre": {
    "fr": "Suites numériques",
    "ar": "المتتاليات العددية"
  },
  "duree_min": 40,
  "objectifs": {
    "fr": [
      "Étudier monotonie et bornes d'une suite",
      "Exploiter les suites arithmétiques et géométriques (termes, sommes)",
      "Déterminer des limites de suites"
    ],
    "ar": [
      "دراسة قطعية المتتالية وحدودها",
      "استثمار المتتاليات الحسابية والهندسية (الحدود والمجاميع)",
      "حساب نهايات المتتاليات"
    ]
  },
  "fiche": [
    {
      "titre": {
        "fr": "Monotonie et bornes",
        "ar": "القطعية والحدود"
      },
      "puces": [
        {
          "fr": "uₙ₊₁ − uₙ ≥ 0 pour tout n → u croissante ; ≤ 0 → décroissante ; = 0 → constante.",
          "ar": "إذا كان uₙ₊₁ − uₙ ≥ 0 لكل n فالمتتالية تزايدية؛ ≤ 0 تناقصية؛ = 0 ثابتة."
        },
        {
          "fr": "u est majorée par M si uₙ ≤ M pour tout n ; minorée par m si uₙ ≥ m ; bornée si les deux.",
          "ar": "تكون u محدودة من فوق بـ M إذا uₙ ≤ M لكل n، ومن تحت بـ m إذا uₙ ≥ m؛ ومحدودة إذا تحقق الاثنان."
        }
      ]
    },
    {
      "titre": {
        "fr": "Suites arithmétiques et géométriques",
        "ar": "المتتاليات الحسابية والهندسية"
      },
      "formules": [
        "arithmétique : uₙ = u₀ + n·r",
        "somme arithmétique : S = (nombre de termes) × (1er + dernier)/2",
        "géométrique : uₙ = u₀ × qⁿ",
        "somme géométrique : S = u₀(1 − qⁿ⁺¹)/(1 − q), q ≠ 1"
      ],
      "exemple": {
        "enonce": {
          "fr": "Suite arithmétique de raison 3 et u₀ = 5 : terme u₁₀ ? Somme des 11 premiers termes ?",
          "ar": "متتالية حسابية أساسها 3 وحدتها الأولى 5: ما الحد u₁₀؟ وما مجموع 11 حداً أولاً؟"
        },
        "etapes": [
          {
            "fr": "u₁₀ = 5 + 10×3 = 35.",
            "ar": "u₁₀ = 5 + 10×3 = 35."
          },
          {
            "fr": "S = 11 × (5 + 35)/2 = 11 × 20 = 220.",
            "ar": "S = 11 × (5 + 35)/2 = 220."
          }
        ],
        "resultat": {
          "fr": "u₁₀ = 35 ; S = 220",
          "ar": "u₁₀ = 35 ؛ S = 220"
        }
      }
    },
    {
      "titre": {
        "fr": "Limites de suites",
        "ar": "نهايات المتتاليات"
      },
      "puces": [
        {
          "fr": "Arithmétique : raison r > 0 → +∞ ; r < 0 → −∞.",
          "ar": "الحسابية: إذا كان الأساس r > 0 فالنهاية +∞؛ وإذا كان r < 0 فالنهاية −∞."
        },
        {
          "fr": "Géométrique : |q| < 1 → 0 ; q > 1 → ±∞ (suivant le signe).",
          "ar": "الهندسية: إذا كان |q| < 1 فالنهاية 0؛ وإذا كان q > 1 فالنهاية ±∞."
        },
        {
          "fr": "Méthode : factoriser par le terme de plus haut degré ; suites auxiliaires (vₙ = uₙ − L) pour les suites arithmético-géométriques.",
          "ar": "الطريقة: التحليل بالحد الأعلى درجة؛ أو استعمال متتالية مساعدة (vₙ = uₙ − L)."
        }
      ]
    }
  ],
  "definitions": [
    {
      "terme": {
        "fr": "Suite arithmétique",
        "ar": "متتالية حسابية"
      },
      "def": {
        "fr": "Chaque terme = précédent + raison r.",
        "ar": "كل حد = السابق + الأساس r."
      }
    },
    {
      "terme": {
        "fr": "Suite géométrique",
        "ar": "متتالية هندسية"
      },
      "def": {
        "fr": "Chaque terme = précédent × raison q.",
        "ar": "كل حد = السابق × الأساس q."
      }
    },
    {
      "terme": {
        "fr": "Convergence",
        "ar": "التقارب"
      },
      "def": {
        "fr": "La suite a une limite finie.",
        "ar": "للمتتالية نهاية منتهية."
      }
    },
    {
      "terme": {
        "fr": "Suite bornée",
        "ar": "متتالية محدودة"
      },
      "def": {
        "fr": "Majorée et minorée à la fois.",
        "ar": "محدودة من فوق ومن تحت."
      }
    }
  ],
  "exercices": [
    {
      "id": "e1",
      "niveau_diff": 1,
      "enonce": {
        "fr": "uₙ = 2n + 5 : arithmétique ? raison ? u₅ ?",
        "ar": "uₙ = 2n + 5: هل هي حسابية؟ ما الأساس؟ وما u₅؟"
      },
      "correction": {
        "etapes": [
          {
            "fr": "uₙ₊₁ − uₙ = 2 → arithmétique de raison 2 ; u₅ = 15.",
            "ar": "الفرق = 2 ← حسابية أساسها 2 ؛ u₅ = 15."
          }
        ],
        "resultat": {
          "fr": "Oui, r = 2, u₅ = 15.",
          "ar": "نعم، r = 2 و u₅ = 15."
        }
      }
    },
    {
      "id": "e2",
      "niveau_diff": 2,
      "enonce": {
        "fr": "u₀ = 2 et uₙ₊₁ = 0,5·uₙ + 3 : calcule u₁ et u₂, puis montre que vₙ = uₙ − 6 est géométrique.",
        "ar": "u₀ = 2 و uₙ₊₁ = 0,5·uₙ + 3: احسب u₁ و u₂ ثم بيّن أن vₙ = uₙ − 6 هندسية."
      },
      "correction": {
        "etapes": [
          {
            "fr": "u₁ = 0,5×2 + 3 = 4 ; u₂ = 0,5×4 + 3 = 5.",
            "ar": "u₁ = 4 ؛ u₂ = 5."
          },
          {
            "fr": "vₙ₊₁ = uₙ₊₁ − 6 = 0,5uₙ − 3 = 0,5(uₙ − 6) = 0,5·vₙ → géométrique de raison 1/2.",
            "ar": "vₙ₊₁ = 0,5(uₙ − 6) = 0,5·vₙ ← هندسية أساسها 1/2."
          }
        ],
        "resultat": {
          "fr": "u₁ = 4 ; u₂ = 5 ; v géométrique (q = 1/2).",
          "ar": "u₁ = 4 ؛ u₂ = 5 ؛ v هندسية (q = 1/2)."
        }
      }
    },
    {
      "id": "e3",
      "niveau_diff": 3,
      "enonce": {
        "fr": "En déduire lim uₙ (question e2).",
        "ar": "استنتج نهاية المتتالية u في التمرين السابق."
      },
      "correction": {
        "etapes": [
          {
            "fr": "vₙ = v₀ × (1/2)ⁿ = (−4)(1/2)ⁿ → 0 (car |q| < 1).",
            "ar": "vₙ = (−4)(1/2)ⁿ ← نهايتها 0."
          },
          {
            "fr": "Donc lim uₙ = 6.",
            "ar": "إذن lim uₙ = 6."
          }
        ],
        "resultat": {
          "fr": "lim uₙ = 6",
          "ar": "lim uₙ = 6"
        }
      },
      "acceptees": [
        "6"
      ]
    }
  ],
