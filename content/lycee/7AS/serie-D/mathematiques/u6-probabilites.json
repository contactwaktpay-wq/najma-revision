      }
    },
    {
      "id": "q4",
      "type": "vf",
      "q": {
        "fr": "E(X) d'une binomiale = n × p.",
        "ar": "قيمة الأمل لذات الحدين = n × p."
      },
      "bonne": true,
      "explication": {
        "fr": "Espérance de la binomiale.",
        "ar": "أمل ذات الحدين."
      }
    },
    {
      "id": "q5",
      "type": "courte",
      "q": {
        "fr": "P(X=2) pour B(3, 0,5) :",
        "ar": "P(X=2) لقانون B(3، 0,5):"
      },
      "acceptees": [
        "0,375",
        "0.375",
        "3/8"
      ],
      "explication": {
        "fr": "C(3,2)·0,5³·3? Non : 3 × 0,125 = 0,375.",
        "ar": "3 × 0,125 = 0,375."
      }
    },
    {
      "id": "q6",
      "type": "qcm",
      "q": {
        "fr": "Si A et B indépendants :",
        "ar": "إذا كان A و B مستقلين:"
      },
      "choix": [
        {
          "fr": "P(A∩B) = P(A)×P(B)",
          "ar": "P(A∩B) = P(A)×P(B)"
        },
        {
          "fr": "P(A∩B) = 0",
          "ar": "P(A∩B) = 0"
        },
        {
          "fr": "P(A∪B) = 1",
          "ar": "P(A∪B) = 1"
        }
      ],
      "bonne": 0,
      "explication": {
        "fr": "Définition de l'indépendance.",
        "ar": "تعريف الاستقلال."
      }
    }
  ],
  "flashcards": [
    {
