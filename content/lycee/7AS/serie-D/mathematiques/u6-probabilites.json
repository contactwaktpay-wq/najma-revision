      "q": {
        "fr": "Tirage 2 sans remise : P(2 rouges) ?",
        "ar": "سحب 2 دون إرجاع: ما P(حمراوين)؟"
      },
      "acceptees": [
        "5/14",
        "0,36",
        "0.36"
      ],
      "explication": {
        "fr": "C(5,2)/C(8,2).",
        "ar": "C(5,2)/C(8,2)."
      }
    },
    {
      "id": "q3",
      "type": "qcm",
      "q": {
        "fr": "Sur l'arbre pondéré, on…",
        "ar": "في الشجرة الموزونة ن…"
      },
      "choix": [
        {
          "fr": "multiplie le long du chemin",
          "ar": "نضرب على طول المسار"
        },
        {
          "fr": "divise",
          "ar": "نقسم"
