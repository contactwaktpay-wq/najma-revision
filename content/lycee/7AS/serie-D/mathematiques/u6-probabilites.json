        "ar": "1 − P(A)."
      }
    },
    {
      "id": "f2",
      "recto": {
        "fr": "P(A/B)",
        "ar": "P(A/B)"
      },
      "verso": {
        "fr": "P(A ∩ B)/P(B).",
        "ar": "P(A ∩ B)/P(B)."
      }
    },
    {
      "id": "f3",
      "recto": {
        "fr": "Binomiale : P(X=k)",
        "ar": "ذات الحدين: P(X=k)"
      },
      "verso": {
        "fr": "C(n,k) pᵏ (1−p)ⁿ⁻ᵏ.",
        "ar": "C(n,k) pᵏ (1−p)ⁿ⁻ᵏ."
      }
    },
    {
      "id": "f4",
      "recto": {
        "fr": "Espérance binomiale",
        "ar": "أمل ذات الحدين"
      },
      "verso": {
