{
  "schema": "sehil.unit@1",
  "statut": "A_RELIRE",
  "id": "7ASD-svn-02",
  "niveau": "7AS",
  "matiere": "sciences_naturelles",
  "ordre": 2,
  "titre": {
    "fr": "Génétique : de l'ADN aux lois de Mendel",
    "ar": "الوراثة: من الحمض النووي إلى قوانين مندل"
  },
  "duree_min": 45,
  "objectifs": {
    "fr": [
      "Relier ADN, gènes, allèles, génotype et phénotype",
      "Appliquer la 1re et la 2e loi de Mendel (monohybridisme)",
      "Résoudre un exercice de dihybridisme (3e loi) et de déterminisme du sexe"
    ],
    "ar": [
      "الربط بين DNA والجينات والأليلات والطراز الوراثي والنمط الظاهري",
      "تطبيق القانونين الأول والثاني لمندل",
      "حل تمرين في الازدواج (القانون الثالث) وتحديد الجنس"
    ]
  },
  "fiche": [
    {
      "titre": {
        "fr": "ADN, gènes et allèles",
        "ar": "الحمض النووي والجينات والأليلات"
      },
      "puces": [
        {
          "fr": "L'ADN est une double hélice de nucléotides (A-T, C-G). Un gène = portion d'ADN codant un caractère.",
          "ar": "الحمض النووي حلزون مزدوج من النكليوتيدات (A-T، C-G). الجين قطعة من الحمض ترمز لصفة."
        },
        {
          "fr": "Allèles : versions différentes d'un même gène (A et a). Génotype = ensemble des allèles (AA, Aa, aa) ; phénotype = caractère observable.",
          "ar": "الأليلات: صور مختلفة للجين نفسه (A و a). الطراز الوراثي = مجموعة الأليلات؛ والنمط الظاهري = الصفة المرئية."
        }
      ]
    },
    {
      "titre": {
        "fr": "Mendel : monohybridisme",
        "ar": "مندل: أحادي الصفة"
      },
      "bloc": [
        {
          "fr": "1re loi (uniformité) : croisement de deux races pures AA × aa → F1 toute Aa, phénotype dominant. 2e loi (disjonction) : F1 × F1 → F2 avec 3/4 dominant et 1/4 récessif (génotypes 1 AA : 2 Aa : 1 aa).",
          "ar": "القانون الأول (الانتظام): تهجين سلالتين خالصتين AA × aa ← الجيل الأول كلها Aa بنمط سائد. القانون الثاني (انفصال الأليلات): F1 × F1 ← F2 بتناسب 3/4 سائد و 1/4 متنحٍ."
        }
      ],
      "exemple": {
        "enonce": {
          "fr": "Croisement Aa × Aa : proportions génotypiques et phénotypiques ?",
          "ar": "تهجين Aa × Aa: ما التناسبات الوراثية والظاهرية؟"
        },
        "etapes": [
          {
            "fr": "Échiquier de croisement : 1 AA, 2 Aa, 1 aa.",
            "ar": "مربع التهجين: 1 AA و 2 Aa و 1 aa."
          },
          {
            "fr": "Phénotypes : 3/4 [A] + 1/4 [a].",
            "ar": "الأنماط الظاهرية: 3/4 سائد + 1/4 متنحٍ."
          }
        ],
        "resultat": {
          "fr": "1 AA : 2 Aa : 1 aa → 3/1.",
          "ar": "1 AA : 2 Aa : 1 aa ← 3/1."
        }
      }
    },
    {
      "titre": {
        "fr": "Dihybridisme et sexe",
        "ar": "الازدواج وتحديد الجنس"
      },
      "puces": [
        {
          "fr": "3e loi (indépendance des gènes sur chromosomes différents) : AaBb × AaBb → 9 [AB] : 3 [Ab] : 3 [aB] : 1 [ab].",
          "ar": "القانون الثالث (استقلال الجينات): AaBb × AaBb ← 9 : 3 : 3 : 1."
        },
        {
          "fr": "Déterminisme du sexe : XX = femelle, XY = mâle ; le père détermine le sexe (spermatozoïdes X ou Y).",
          "ar": "تحديد الجنس: XX أنثى و XY ذكر؛ والأب هو الذي يحدد الجنس (نطائف X أو Y)."
        }
      ]
    }
  ],
  "definitions": [
    {
      "terme": {
        "fr": "Allèle",
        "ar": "الأليل"
      },
      "def": {
        "fr": "Version d'un gène située au même locus.",
        "ar": "صورة من الجين في الموضع نفسه."
      }
    },
    {
      "terme": {
        "fr": "Homozygote / hétérozygote",
        "ar": "متماثل الأليلات / مغاير الأليلات"
      },
      "def": {
        "fr": "AA ou aa / Aa.",
        "ar": "AA أو aa / Aa."
      }
    },
    {
      "terme": {
        "fr": "Dominant / récessif",
        "ar": "سائد / متنحٍ"
      },
      "def": {
        "fr": "Allèle qui s'exprime à l'état hétérozygote / qui ne s'exprime qu'en homozygotie.",
        "ar": "الأليل الذي يظهر في المغاير / الذي يظهر فقط في التماثل."
      }
    }
  ],
  "exercices": [
    {
      "id": "e1",
      "niveau_diff": 1,
      "enonce": {
        "fr": "AA × aa : génotypes et phénotypes de F1 ?",
        "ar": "AA × aa: ما طرازات وأنماط الجيل الأول؟"
      },
      "correction": {
        "etapes": [
          {
            "fr": "100 % Aa → phénotype [A] (dominant).",
            "ar": "كلها Aa ← النمط السائد."
          }
        ],
        "resultat": {
          "fr": "F1 : 100 % Aa.",
          "ar": "الجيل الأول: كلها Aa."
        }
      }
    },
    {
      "id": "e2",
      "niveau_diff": 2,
      "enonce": {
        "fr": "Aa × aa : proportions attendues ?",
        "ar": "Aa × aa: ما التناسبات المتوقعة؟"
      },
      "correction": {
        "etapes": [
          {
            "fr": "1 Aa : 1 aa → 1/2 [A], 1/2 [a].",
            "ar": "1 Aa : 1 aa ← نصف سائد ونصف متنحٍ."
          }
        ],
        "resultat": {
          "fr": "1/2 – 1/2.",
          "ar": "1/2 – 1/2."
        }
      }
    },
    {
      "id": "e3",
      "niveau_diff": 3,
      "enonce": {
        "fr": "AaBb × AaBb : proportion du phénotype double récessif [ab] ?",
        "ar": "AaBb × AaBb: ما نسبة النمط المزدوج المتنحي؟"
      },
      "correction": {
        "etapes": [
          {
            "fr": "3e loi : (1/4) × (1/4) = 1/16.",
            "ar": "القانون الثالث: (1/4) × (1/4) = 1/16."
          }
        ],
        "resultat": {
          "fr": "1/16",
          "ar": "1/16"
        }
      },
      "acceptees": [
        "1/16"
      ]
    }
  ],
