      },
      "choix": [
        {
          "fr": "3,7 × 10⁻⁴",
          "ar": "3,7 × 10⁻⁴"
        },
        {
          "fr": "37 × 10⁻⁵",
          "ar": "37 × 10⁻⁵"
        },
