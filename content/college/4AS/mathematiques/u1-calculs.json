    {
      "id": "q4",
      "type": "courte",
      "q": {
        "fr": "Simplifie √72 (forme a√b).",
        "ar": "بسّط √72 بالصورة a√b."
      },
      "acceptees": [
        "6√2",
        "6racine2",
        "6 * sqrt(2)"
      ],
