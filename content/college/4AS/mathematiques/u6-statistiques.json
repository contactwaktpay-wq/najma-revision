      "recto": {
        "fr": "Formule de la moyenne pondérée",
        "ar": "صيغة المتوسط المرجّح"
      },
      "verso": {
        "fr": "Σ(valeur × effectif) ÷ total.",
        "ar": "مجموع (القيمة × التكرار) ÷ الكلي."
      }
    },
    {
