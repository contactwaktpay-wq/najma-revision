    {
      "id": "q5",
      "type": "vf",
      "q": {
        "fr": "La moyenne dépend des effectifs de chaque valeur.",
        "ar": "المتوسط يعتمد على تكرارات كل قيمة."
      },
      "bonne": true,
      "explication": {
        "fr": "C'est une moyenne pondérée.",
